# 로컬 테스트용 (GitHub Actions에서는 대신 Repository Secrets / Variables 사용)

# 1. Google AI Studio (https://aistudio.google.com/) 에서 발급
GEMINI_API_KEY=

# 2. Meta for Developers 앱 (https://developers.facebook.com/) 에서 발급
META_APP_ID=
META_APP_SECRET=

# 3. Instagram Graph API 장기 액세스 토큰 + 비즈니스 계정 ID
IG_LONG_LIVED_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_HANDLE=@my_instagram

# 4. Threads API 장기 액세스 토큰 + 사용자 ID
THREADS_LONG_LIVED_TOKEN=
THREADS_USER_ID=

# 5. (선택) Apify 토큰 — 큐가 비었을 때 인스타 벤치마크 계정에서 소재를 발굴
#    https://apify.com 무료 가입 시 매달 5달러 크레딧 제공
APIFY_TOKEN=

# 게시할 카드뉴스 테마: gray | blue | amber  (모두 4:5 1080×1350)
CARD_THEME=gray

# 실제로 인스타/스레드에 게시하지 않고 이미지 생성까지만 하고 싶을 때 true
DRY_RUN=true

# (선택) 발행 직후 표지 카드를 스토리에도 리포스트 — 첫 1시간 도달용
POST_STORY=false

# (선택) 위치 태그로 쓸 장소 페이지 ID — 지역 도달용
IG_LOCATION_ID=

# (선택) 댓글 키워드 → 자동 DM 켜기. 켜기 전에 data/dm-templates.json 의 resourceUrl 을 채울 것
#        필요한 권한: instagram_manage_comments, instagram_manage_messages
COMMENT_DM_ENABLED=false
