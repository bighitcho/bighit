# 로컬 테스트용 (GitHub Actions에서는 대신 Repository Secrets 사용)

# 1. Google AI Studio (https://aistudio.google.com/) 에서 발급
GEMINI_API_KEY=

# 2. Meta for Developers 앱 (https://developers.facebook.com/) 에서 발급
META_APP_ID=
META_APP_SECRET=

# 3. Instagram Graph API 장기 액세스 토큰 + 비즈니스 계정 ID
IG_LONG_LIVED_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_HANDLE=@my_instagram

# 4. Threads API 장기 액세스 토큰 + 사용자 ID
THREADS_LONG_LIVED_TOKEN=
THREADS_USER_ID=

# 게시할 인스타그램 카드뉴스 테마: gray | blue | square
CARD_THEME=gray

# 실제로 인스타/스레드에 게시하지 않고 이미지 생성까지만 하고 싶을 때 true
DRY_RUN=true
